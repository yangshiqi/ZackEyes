---
import { sourceUrl } from '../lib/release.mjs';
import { contributors } from '../lib/contributors.mjs';
---

<footer class="footer">
  <span>ZackEyes for macOS · open source under MIT</span>
  <span>
    <a href="/docs">Docs</a> ·
    <a href="/changelog">Changelog</a> ·
    <a href="/roadmap">Roadmap</a> ·
    <a href="/answers">Answers</a> ·
    <a href="/security">Security</a> ·
    <a href="/privacy">Privacy</a> ·
    <a href="/download">Download</a> ·
    <a href={sourceUrl} rel="noopener">Source</a> ·
    Claude Code + Codex CLI agent awareness
  </span>
  <span class="footer-contributors">
    <span class="footer-contributors-label">Built by</span>
    {contributors.map((c) => (
      <a
        href={`https://github.com/${c.login}`}
        rel="noopener"
        title={`${c.name} on GitHub`}
      >
        <img
          src={`https://github.com/${c.login}.png?size=44`}
          alt={c.name}
          width="22"
          height="22"
          loading="lazy"
        />
        <span>{c.name}</span>
      </a>
    ))}
  </span>
</footer>
