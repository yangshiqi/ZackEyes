---
import '../styles/global.css';
import { appVersion, downloadUrl, sourceUrl, releasesUrl } from '../lib/release.mjs';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title = 'ZackEyes - AI Agent Command Center in the MacBook Notch',
  description = 'ZackEyes turns the MacBook notch into a live command center for Claude Code and Codex CLI sessions, approvals, tasks, and usage pressure.',
  canonical,
  image = '/og-image.svg',
  structuredData: pageStructuredData = []
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://zackeyes.vercel.app';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}/#organization`,
      name: 'ZackEyes',
      url: site,
      logo: new URL('/icon.svg', site).href,
      sameAs: [sourceUrl, releasesUrl]
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      name: 'ZackEyes',
      url: site,
      description,
      publisher: { '@id': `${site}/#organization` },
      inLanguage: 'en'
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${site}/#software`,
      name: 'ZackEyes',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS',
      softwareVersion: appVersion,
      url: site,
      downloadUrl,
      description,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD'
      },
      featureList: [
        'Claude Code session visibility',
        'Codex CLI session visibility',
        'Permission approval prompts',
        'Rate-limit awareness',
        'Multiple themes',
        'Real notch and simulated island display modes',
        'macOS notch command center'
      ]
    }
  ].concat(pageStructuredData)
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050605" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ZackEyes" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <slot />
  </body>
</html>
