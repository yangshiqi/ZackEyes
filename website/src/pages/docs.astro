---
import { candidateVersion, journalVersion } from '../lib/product-plans.mjs';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import InstallSecurityNote from '../components/InstallSecurityNote.astro';
import { appVersion, downloadUrl, issuesUrl, sourceUrl } from '../lib/release.mjs';

const description = 'Install and remove ZackEyes on macOS 14+, understand local pricing, and configure candidate SSH observation, question answers and daily Usage archives.';
const docsStructuredData = [
  {
    '@type': 'TechArticle',
    '@id': 'https://zackeyes.vercel.app/docs#compatibility',
    headline: 'ZackEyes compatibility requirements',
    description,
    about: ['macOS 14', 'Apple Silicon', 'Intel Mac', 'Claude Code', 'Codex CLI']
  },
  {
    '@type': 'HowTo',
    '@id': 'https://zackeyes.vercel.app/docs#install',
    name: 'Install ZackEyes',
    step: [
      { '@type': 'HowToStep', name: 'Download the DMG', text: 'Download the latest ZackEyes DMG from GitHub Releases.' },
      { '@type': 'HowToStep', name: 'Open the installer', text: 'Open the DMG and drag ZackEyes into Applications.' },
      { '@type': 'HowToStep', name: 'Launch ZackEyes', text: 'Start ZackEyes and keep Claude Code or Codex CLI running in your normal terminal workflow.' }
    ]
  }
];
---

<SiteLayout
  title="Docs - ZackEyes"
  description={description}
  canonical="https://zackeyes.vercel.app/docs"
  structuredData={docsStructuredData}
>
  <div class="grain" aria-hidden="true"></div>

  <div class="site-shell">
    <SiteHeader />

    <main id="top">
      <section class="policy-hero compact-page-hero" aria-labelledby="docs-title">
        <div class="policy-shell">
          <div class="section-eyebrow">Setup guide</div>
          <h1 id="docs-title">Install ZackEyes.</h1>
          <p class="policy-lede">
            ZackEyes ships as a universal macOS DMG for Apple Silicon and Intel Macs. The current app target requires macOS 14 or newer.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={downloadUrl}>Download {appVersion} <span aria-hidden="true">↓</span></a>
            <a class="button" href={issuesUrl}>Report install issue <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="install-title">
        <div class="policy-shell docs-layout">
          <div>
            <h2 class="section-title" id="install-title">Install.</h2>
            <p class="section-copy">
              Use the public release channel for the latest installer asset and future update checks.
            </p>
          </div>
          <ol class="step-list">
            <li><strong>Download the DMG.</strong> Use the latest ZackEyes installer from GitHub Releases.</li>
            <li><strong>Open the DMG.</strong> Drag ZackEyes into Applications when Finder shows the installer window.</li>
            <li><strong>Launch the app.</strong> Keep Claude Code or Codex CLI running in your normal terminal; ZackEyes installs the supported hooks when it can find those CLIs.</li>
            <li><strong>Handle macOS security prompts.</strong> If macOS asks for confirmation on first launch, approve the app from System Settings and reopen it.</li>
            <li><strong>Review optional permissions.</strong> Accessibility permission enables terminal tab jump. Notifications permission enables macOS alerts for completed turns, rate limits, update availability, and errors.</li>
          </ol>
          <InstallSecurityNote />
        </div>
      </section>

      <section class="faq-band" aria-labelledby="compat-title">
        <div class="section-inner">
          <div class="section-eyebrow">Compatibility</div>
          <h2 class="section-title" id="compat-title">What is supported.</h2>
          <div class="spec-grid">
            <article>
              <span>macOS</span>
              <strong>macOS 14+</strong>
              <p>The Swift package target is `macOS(.v14)`, so Sonoma or newer is the supported baseline.</p>
            </article>
            <article>
              <span>Architecture</span>
              <strong>Apple Silicon + Intel</strong>
              <p>The release build uses both `arm64` and `x86_64`, producing a universal macOS app bundle for the DMG.</p>
            </article>
            <article>
              <span>Agents</span>
              <strong>Claude Code + Codex CLI</strong>
              <p>ZackEyes installs hooks for whichever CLI it finds and skips missing agents without breaking the terminal workflow.</p>
            </article>
            <article>
              <span>Terminal jump</span>
              <strong>iTerm2, Terminal.app, Ghostty, Warp, WezTerm, Kitty, Alacritty, VS Code, Cursor</strong>
              <p>With Accessibility permission, clicking a session card can activate the terminal tab where that agent is running.</p>
            </article>
            <article>
              <span>Controls</span>
              <strong>Unified Settings window</strong>
              <p>A Settings window — opened from the notch gear or the menu-bar icon — collects the global hotkey, island visibility, quota presentation, and a Preferred quota source that picks whether the compact pill favors Claude or Codex.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="model-compatibility">
        <div class="policy-shell">
          <h2 class="section-title" id="model-compatibility">Model compatibility.</h2>
          <p class="section-copy">v0.9.7 adds the following model and protocol support. The current download is v{appVersion}.</p>
          <ul class="step-list">
            <li><strong>Codex GPT-6.1 Sol and GPT-6 Astra.</strong> Observed reasoning effort appears beside the model. Request-aware estimates account for reported service tiers and eligible long requests; concurrent tool, interruption, subagent and compaction events preserve the correct turn. <a href="https://github.com/yangshiqi/ZackEyes/pull/252">PR #252</a>.</li>
            <li><strong>Claude Fable 5/5.1, Opus 5/5.5 and Sonnet 5/5.5.</strong> Cards follow model changes and display observed effort. Daily estimates distinguish actual fast responses and 5-minute/1-hour cache writes. Failed tools and API failures receive separate handling; child completion does not notify parent completion. <a href="https://github.com/yangshiqi/ZackEyes/pull/258">PR #258</a>.</li>
            <li><strong>Metadata availability.</strong> Effort is shown only after the CLI supplies it; no model default or global configuration is inferred. A local Claude Code 2.1.295 probe supplied effort on Stop, after the reply. Startup recovery can restore the model without restoring effort.</li>
            <li><strong>Cost estimates.</strong> Daily totals use API list prices, not subscription invoices. Codex costs may be incomplete when request metadata or pre-attachment history is missing. Claude session-card cost uses the CLI-reported total. Unknown model pricing remains unpriced.</li>
            <li><strong>Codex hooks.</strong> The current flag is <code>hooks</code>; <code>codex_hooks</code> is deprecated. ZackEyes does not read or modify <code>~/.codex/config.toml</code>. These changes observe existing CLI sessions and do not add native steering or a second agent runtime.</li>
          </ul>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="source-title">
        <div class="policy-shell docs-layout">
          <div>
            <h2 class="section-title" id="source-title">Build from source.</h2>
            <p class="section-copy">
              ZackEyes is MIT-licensed and the full app, bridge CLI, and this website live in one monorepo. If you'd rather build the DMG yourself, audit the hook installer, or hack on a feature, clone the repo and run the same Makefile we ship from.
            </p>
          </div>
          <ol class="step-list">
            <li><strong>Clone the source.</strong> <code>git clone https://github.com/yangshiqi/ZackEyes.git</code></li>
            <li><strong>Need Xcode Command Line Tools.</strong> <code>xcode-select --install</code> if you haven't already; the build uses Swift 6 from the system toolchain.</li>
            <li><strong>Build the app.</strong> <code>cd ZackEyes && make app</code> produces a debug bundle. <code>make app-release</code> builds the universal release bundle. <code>make dmg</code> wraps it into a drag-to-Applications DMG.</li>
            <li><strong>Run the tests.</strong> <code>swift test</code> exercises the bridge, hook installer, socket types, remote observation and notch logic.</li>
            <li><strong>Contribute.</strong> Pick a <a href={`${sourceUrl}/contribute`} rel="noopener">good first issue</a>, open a PR. See <a href={sourceUrl} rel="noopener">the repo README</a> for the workflow.</li>
          </ol>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="development-builds">
        <div class="policy-shell">
          <h2 class="section-title" id="development-builds">Development builds.</h2>
          <p class="section-copy">The v{candidateVersion} release candidate in master includes opt-in supported Claude question answers, SSH remote observation, demo sessions, local usage history and stale quota hints. These are not yet in the published v{appVersion} download. See the <a href="/roadmap">roadmap</a> and repository README for source-build setup.</p>
          <p class="section-copy">Settings → Usage shows complete local days through yesterday. Hover a daily chart for its full date and per-agent values. Daily archives settle after 03:00 with startup catch-up; changing periods or refreshing reads the saved archives. Use Import saved history or Import older transcripts for earlier data, with Pause and Resume across restarts. Today/quota readings remain separate. Skipped source observations can leave estimates incomplete.</p>
          <figure class="feature-screenshot">
            <a href="/screenshots/usage-history.webp" aria-label="View Usage history screenshot at full size"><img src="/screenshots/usage-history.webp" alt="Usage settings showing seven completed local days of sample Claude and Codex counts and estimated agent-hours." width="1800" height="1960" loading="lazy" decoding="async" /></a>
            <figcaption>Usage history · v{candidateVersion} candidate · isolated sample data. Select the image for full size.</figcaption>
          </figure>
          <h3 id="notch-answers">Answer supported Claude questions.</h3>
          <p class="section-copy">In the candidate build, enable Settings → Notifications → Answer questions from the notch (off by default). Select the supported choices and press Submit. Unanswered questions fall back to the terminal after two minutes; unsupported questions and remote requests remain in their terminal. Tool permission approvals and question answers are separate actions.</p>
          <figure class="feature-screenshot">
            <a href="/screenshots/notch-question.webp" aria-label="View sample notch question at full size"><img src="/screenshots/notch-question.webp" alt="Built-in Demo showing a sample Claude layout question with Grid and List choices." width="1040" height="960" loading="lazy" decoding="async" /></a>
            <figcaption>Supported question choices in the candidate's built-in Demo. No real agent receives the answer.</figcaption>
          </figure>
          <h3 id="demo-mode">Explore Demo mode.</h3>
          <p class="section-copy">Choose Demo mode from the menu-bar or notch gear menu. Synthetic Claude/Codex sessions cycle through working, waiting and idle states; sample approvals and questions are interactive. Exit demo returns to live sessions. Real questions, approvals or errors also return to the live view. DEMO badges identify sample cards; quota bars continue to use account readings and can show no data.</p>
          <h3 id="usage-history">Read and extend Usage history.</h3>
          <p class="section-copy">The Today row is live token/cost information; Settings → Usage is a separate archive of completed days, not a historical billing report. Automatic setup covers the last three completed days. Import older transcripts extends available history; Import saved history migrates the old ledger without changing it. Pause and Resume preserve committed progress across restarts. Parallel sessions add agent-hours, so a day may exceed 24 estimated hours. Deleted source history cannot be reconstructed, and invalid/oversized observations may leave estimates incomplete.</p>
          <p class="section-copy">Daily work journal is still under development for v{journalVersion}. Its public generation menu is hidden; setup, publishing and scheduling are unfinished and excluded from the v{candidateVersion} candidate.</p>
          <p class="section-copy">Remote observation requires Swift 6 on the remote Linux/macOS host: build <code>swift build -c release --product zackeyes-stream</code> and install the result as <code>~/.local/bin/zackeyes</code>. Verify key authentication and the host key in your terminal, then add the SSH alias in Settings → Remote Hosts. Remote approvals and questions remain in the remote terminal.</p>
          <h3 id="ssh-troubleshooting">Connect and troubleshoot SSH hosts.</h3>
          <p class="section-copy">Use Settings → Remote Hosts → Add Host with a name and existing SSH alias or user@hostname. Configure custom ports, identity files or jump hosts in your own SSH configuration. ZackEyes does not edit it. Before enabling the host, verify <code>ssh your-host</code> in a terminal, then verify <code>ssh your-host '~/.local/bin/zackeyes --stream'</code>. The helper must be built separately with Swift 6 and installed on that host.</p>
          <p class="section-copy">Authentication or host-key errors must be resolved in the terminal; ZackEyes does not show password prompts or accept unknown host keys. A missing helper requires installing the stream binary; an unsupported stream requires updating the helper. Connection status appears beside each host. Remote cards are metadata observations, not proof of a running process, and have no local approval or terminal-jump actions.</p>
          <figure class="feature-screenshot">
            <a href="/screenshots/remote-hosts.webp" aria-label="View SSH host setup screenshot at full size"><img src="/screenshots/remote-hosts.webp" alt="Remote Hosts settings showing two disabled example SSH aliases and the remote helper setup command." width="1800" height="1960" loading="lazy" decoding="async" /></a>
            <figcaption>SSH host setup · v{candidateVersion} candidate · disabled example hosts, with no connection attempted.</figcaption>
          </figure>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="uninstall-title">
        <div class="policy-shell docs-layout">
          <div>
            <h2 class="section-title" id="uninstall-title">Uninstall ZackEyes.</h2>
            <p class="section-copy">
              Remove the agent integrations while the app is still installed, then quit and delete the app. Keep local data if you want to preserve Usage history for a reinstall.
            </p>
          </div>
          <ol class="step-list">
            <li><strong>Uninstall integrations.</strong> Open Settings → Integrations → Uninstall Integrations… and complete the removal before deleting the app. This removes ZackEyes-managed agent entries.</li>
            <li><strong>Quit and remove ZackEyes.</strong> Quit from its menu and delete the app from Applications.</li>
            <li><strong>Retain or delete local data.</strong> Removing <code>~/.zackeyes</code> deletes settings, saved Usage history, SSH host configuration and any existing local journal files. Copy that directory first if you want to retain them; a reinstall cannot reconstruct deleted history after its source transcripts are gone.</li>
          </ol>
        </div>
      </section>

      <section class="faq-band" id="troubleshooting" aria-labelledby="troubleshooting-title">
        <div class="section-inner">
          <div class="section-eyebrow">Troubleshooting</div>
          <h2 class="section-title" id="troubleshooting-title">Common setup problems.</h2>
          <div class="faq-list">
            <details class="faq-item" open>
              <summary>macOS says ZackEyes cannot be opened</summary>
              <p>The app is ad-hoc signed and not notarized. Use the verified official download and follow the first-launch command in the Install section or the installer README, then open it again from Applications.</p>
            </details>
            <details class="faq-item">
              <summary>Claude or Codex sessions do not appear</summary>
              <p>Confirm the relevant CLI is installed and start a fresh Claude Code or Codex CLI session. Codex threads that started before hooks were installed may need a new thread for full hook-driven behavior.</p>
            </details>
            <details class="faq-item">
              <summary>Permission requests do not show in the notch</summary>
              <p>Check that ZackEyes is running and that the agent hook file contains a ZackEyes-managed command. If the app is closed, the agent should fall back to its native terminal prompt.</p>
            </details>
            <details class="faq-item">
              <summary>Reinstall hooks</summary>
              <p>Open Settings → Integrations and choose Repair Hooks, then start a fresh agent session. The repair backs up hook files and preserves unrelated settings.</p>
            </details>
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</SiteLayout>
