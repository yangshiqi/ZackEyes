---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import {
  appVersion,
  releaseName,
  downloadUrl,
  issuesUrl,
  downloadSizeLabel,
  downloadSha256,
  sourceUrl,
  contributeUrl,
  licenseUrl
} from '../lib/release.mjs';

const description = 'ZackEyes turns the MacBook notch into a live command center for Claude Code and Codex CLI sessions, approvals, tasks, rate limits, terminal tab jump, themes, and display modes.';
const screenshots = [
  {
    src: '/screenshots/dual-agent-support.webp',
    alt: 'ZackEyes panel showing Claude Code and Codex CLI sessions together with separate usage tracks.',
    label: 'Claude plus Codex',
    title: 'Split usage tracks and badges keep Claude Code and Codex CLI sessions separate.',
    width: 1008,
    height: 854
  },
  {
    src: '/screenshots/terminal-confirmation.webp',
    alt: 'ZackEyes AskUserQuestion prompt with a button that sends the user back to answer in terminal.',
    label: 'Terminal handoff',
    title: 'AskUserQuestion moments show the prompt and send you back to the terminal when needed.',
    width: 1004,
    height: 910
  },
  {
    src: '/screenshots/settings-general.webp',
    alt: 'ZackEyes Settings window, General tab, showing Preferred quota source, Progress mode, and Dynamic Island options.',
    label: 'Settings',
    title: 'One Settings window for visibility, Preferred quota source, quota presentation, hotkey, and integrations.',
    width: 1440,
    height: 1104
  },
  {
    src: '/screenshots/sessions-attention.webp',
    alt: 'ZackEyes expanded panel grouping sessions into Running and Recent above 5h and 7d quota bars.',
    label: 'Attention-first',
    title: 'Sessions group into Needs You, Running, and Recent so whatever is waiting on you surfaces first.',
    width: 1020,
    height: 926
  }
];
const faqItems = [
  {
    question: 'Which macOS versions does ZackEyes support?',
    answer: 'ZackEyes is built for modern macOS desktop workflows and distributed as a DMG installer. If you hit a version-specific issue, report your macOS version and Mac model in GitHub Issues.'
  },
  {
    question: 'Does ZackEyes work with Claude Code and Codex CLI?',
    answer: 'Yes. ZackEyes is designed as a companion for Claude Code and Codex CLI sessions, showing agent state, permission moments, task progress, and usage pressure near the MacBook notch.'
  },
  {
    question: 'Does ZackEyes collect my code or agent prompts?',
    answer: 'ZackEyes is local-first by default. The website download flow uses GitHub Releases, and feedback goes through GitHub Issues, but the app does not need an account to show local agent status.'
  },
  {
    question: 'Where should I report bugs or feature requests?',
    answer: 'Use the ZackEyes release repository Issues page for bugs, install problems, compatibility reports, and product requests. Include your ZackEyes version, macOS version, agent CLI, and reproduction steps.'
  },
  {
    question: 'Does ZackEyes work on Macs without a notch?',
    answer: 'Yes. ZackEyes includes a simulated Dynamic Island-style panel for Macs without a physical notch, so desktop Macs and older MacBooks can still use the same agent awareness workflow.'
  },
  {
    question: 'Does ZackEyes work with external displays?',
    answer: 'ZackEyes is built for the macOS top-edge workflow. If behavior differs across built-in and external displays, file a GitHub Issue with the display setup and macOS version.'
  },
  {
    question: 'Does ZackEyes support multiple themes?',
    answer: 'Yes. ZackEyes supports Rock Legends, F1 2026, AI Moguls, and Crayon Shin-chan themes, each with matching buddy names and notification sound choices.'
  },
  {
    question: 'Which terminals can ZackEyes jump to?',
    answer: 'ZackEyes can jump to the right terminal tab in iTerm2, Terminal.app, Ghostty, Warp, WezTerm, Kitty, Alacritty, VS Code, and Cursor when Accessibility permission is granted.'
  },
  {
    question: 'Why does ZackEyes write Claude and Codex hooks?',
    answer: 'Hooks let ZackEyes receive local agent lifecycle, permission, task, and completion events without turning into a hosted dashboard. ZackEyes-managed hook commands include the string zackeyes so they can be identified later.'
  },
  {
    question: 'What happens if ZackEyes is closed?',
    answer: 'The bridge is designed to fail quietly and return control to the terminal workflow. Claude Code and Codex CLI should continue using their native behavior when ZackEyes is not available.'
  }
];
const faqStructuredData = {
  '@type': 'FAQPage',
  '@id': 'https://zackeyes.vercel.app/#faq',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---

<SiteLayout
  title="ZackEyes - AI Agent Command Center in the MacBook Notch"
  description={description}
  structuredData={[faqStructuredData]}
>
  <canvas class="cosmos" id="cosmos" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>

  <div class="site-shell">
    <SiteHeader />

    <main id="top">
      <section class="hero" aria-label="ZackEyes overview">
        <div class="hero-grid">
          <div>
            <div class="kicker"><span class="pulse" aria-hidden="true"></span> macOS native agent panel</div>
            <h1>
              <span>Your AI agents</span>
              <span class="accent">in the notch.</span>
            </h1>
            <p class="hero-copy">
              ZackEyes turns the MacBook notch into a live command center for Claude Code and Codex CLI: sessions, tasks, rate limits, and permission prompts stay visible without stealing focus.
            </p>
            <div class="hero-actions">
              <a class="button primary" href={downloadUrl}>Download for macOS</a>
              <a class="button" href="#control">See the flow</a>
            </div>
            <div class="compat-row" aria-label="Supported agents and features">
              <span class="chip">Claude Code</span>
              <span class="chip">Codex CLI</span>
              <span class="chip">Multiple themes</span>
              <span class="chip">Permission approvals</span>
            </div>
          </div>

          <div class="device-stage" aria-hidden="true">
            <div class="device">
              <div class="screen">
                <div class="menu-strip"></div>
                <div class="screen-notch"></div>
                <div class="island">
                  <div class="island-head">
                    <div class="status-title">ZackEyes command center</div>
                    <div class="live-pill"><span class="pulse"></span> LIVE</div>
                  </div>
                  <div class="agent-list">
                    <div class="agent-row">
                      <div class="agent-icon">C</div>
                      <div>
                        <div class="agent-name">Claude Code</div>
                        <div class="agent-task">Refactoring NotchExpandedView</div>
                      </div>
                      <div class="meter"><span></span></div>
                    </div>
                    <div class="agent-row">
                      <div class="agent-icon">X</div>
                      <div>
                        <div class="agent-name">Codex CLI</div>
                        <div class="agent-task">Running bridge tests</div>
                      </div>
                      <div class="meter"><span></span></div>
                    </div>
                  </div>
                </div>
                <div class="permission-float">
                  <div class="permission-title">Permission request</div>
                  <div class="permission-copy">Allow shell command in current project?</div>
                  <div class="permission-actions">
                    <button class="mini-button" type="button">Allow</button>
                    <button class="mini-button deny" type="button">Deny</button>
                  </div>
                </div>
              </div>
              <div class="base">
                <div class="trackpad"></div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="scroll-story" id="control" aria-label="Kinetic typography story">
        <div class="story-sticky">
          <div class="kinetic-stack">
            <p class="kinetic-line" style="--offset: -16;">Less terminal hunting.</p>
            <p class="kinetic-line" style="--offset: 22;">More agent awareness.</p>
            <p class="kinetic-line" style="--offset: -8;">Always in sight.</p>
            <p class="story-caption">
              When the agent starts, stalls, asks, finishes, or hits a limit, the signal appears where your eyes already are: the top edge of the screen.
            </p>
          </div>
        </div>
      </section>

      <section class="screenshot-band" aria-labelledby="screenshots-title">
        <div class="section-inner">
          <div class="section-eyebrow">Product screenshots</div>
          <h2 class="section-title" id="screenshots-title">Real agent state, not a dashboard fantasy.</h2>
          <p class="section-copy">
            These are live ZackEyes surfaces — split Claude / Codex usage tracks, the terminal handoff, the unified Settings window, and attention-first session grouping in the same workflow.
          </p>

          <div class="screenshot-showcase" aria-label="ZackEyes screenshots">
            {screenshots.map((shot) => (
              <figure class:list={['screenshot-tile', { 'is-wide': shot.variant === 'wide' }]}>
                <div class="screenshot-frame">
                  <img
                    src={shot.src}
                    alt={shot.alt}
                    width={shot.width}
                    height={shot.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption>
                  <span>{shot.label}</span>
                  {shot.title}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <section class="band" id="agents" aria-labelledby="agents-title">
        <div class="section-inner">
          <h2 class="section-title" id="agents-title">Built for the messy middle of coding with agents.</h2>
          <p class="section-copy">
            ZackEyes is not another chat surface. It is a small operating layer for the moments when autonomous tools need your attention, but your editor should stay in front.
          </p>

          <div class="feature-grid">
            <article class="feature-card">
              <span class="feature-index">01</span>
              <h3>Session state at a glance</h3>
              <p>Track active Claude and Codex sessions, current tasks, completion, and waiting states from one compact notch panel.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">02</span>
              <h3>Permission prompts without context switching</h3>
              <p>Approve or deny sensitive tool calls from the panel. Claude AskUserQuestion prompts surface in the island and can send you straight back to the terminal answer path.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">03</span>
              <h3>Rate limits where they matter</h3>
              <p>See 5-hour and 7-day usage pressure before a turn fails at the worst possible time.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">04</span>
              <h3>Multiple themes</h3>
              <p>Choose Rock Legends, F1 2026, AI Moguls, or Crayon Shin-chan themes with matching buddy names and custom notification sounds.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">05</span>
              <h3>Display modes for real notches, simulated islands, menu bar use, and external displays</h3>
              <p>Use the physical notch when it exists, switch to a simulated Dynamic Island-style panel when it does not, and keep the same agent signals visible across desktop setups.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">06</span>
              <h3>Quieter notifications</h3>
              <p>Tune the product around attention moments: pending approvals, task completion, stalled work, and useful usage pressure.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">07</span>
              <h3>Jump to the right terminal tab</h3>
              <p>Click a session card to bring forward the matching iTerm2, Terminal.app, Ghostty, Warp, WezTerm, Kitty, Alacritty, VS Code, or Cursor tab. When nothing matches, the card says why instead of doing nothing.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">08</span>
              <h3>Context window usage</h3>
              <p>See per-session context window pressure, model and cost metadata, and rate-limit tracks when the agent exposes them.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">09</span>
              <h3>Hotkey and update controls</h3>
              <p>Use a custom global hotkey, hide or show the island, choose the compact agent display, and install updates through in-app DMG download.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">10</span>
              <h3>Daily token and cost tracking</h3>
              <p>A Today row tracks token spend and USD cost across Claude and Codex, with a 7-day sparkline. Model pricing is bundled and refreshed offline — no API key, no cloud calculation.</p>
            </article>
            <article class="feature-card">
              <span class="feature-index">11</span>
              <h3>What each session is actually touching</h3>
              <p>Open ports, git branch, uncommitted file count, what a dispatched Claude subagent is working on, and whether the agent is compacting its context rather than stalling. Ports come from kernel syscalls, not lsof.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="split-band" aria-labelledby="trust-title">
        <div class="split-grid">
          <div>
            <h2 class="section-title" id="trust-title">Native hooks. Silent failure. Zero drama.</h2>
            <p class="section-copy">
              The bridge speaks through Unix sockets, keeps agent hooks quiet when the app is closed, and leaves your terminal workflow intact.
            </p>
            <p class="section-note">
              ZackEyes is local-first by default. Read the <a href="/privacy">privacy notes</a> for what the website and app do outside your Mac.
            </p>
          </div>
          <div class="terminal-panel" aria-label="Example terminal event stream">
            <div class="terminal-top">
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </div>
            <pre class="code-lines"><span class="green">$</span> claude code
<span class="cyan">hook</span> SessionStart -> /tmp/zackeyes.sock
<span class="cyan">hook</span> PreToolUse -> task visible in notch
<span class="orange">ask</span> PermissionRequest -> approve from panel
<span class="cyan">hook</span> Stop -> notify when complete

<span class="green">$</span> codex
<span class="cyan">jsonl</span> task_started -> live fallback
<span class="cyan">jsonl</span> task_complete -> done</pre>
          </div>
        </div>
      </section>

      <section class="band" id="open-source" aria-labelledby="open-source-title">
        <div class="section-inner">
          <div class="section-eyebrow">Open source</div>
          <h2 class="section-title" id="open-source-title">Read the code that watches your agents.</h2>
          <p class="section-copy">
            ZackEyes is MIT-licensed. Every hook installer, socket message, and notch animation lives in the open. Audit it, fork it, ship a competing notch — just don't break Claude Code.
          </p>
          <p class="section-note">
            <a href={sourceUrl} rel="noopener">github.com/yangshiqi/ZackEyes</a> ·
            <a href={licenseUrl} rel="noopener">MIT License</a> ·
            <a href={contributeUrl} rel="noopener">Contribute</a>
          </p>
        </div>
      </section>

      <section class="faq-band" id="faq" aria-labelledby="faq-title">
        <div class="section-inner">
          <div class="section-eyebrow">Support signal</div>
          <h2 class="section-title" id="faq-title">Frequently asked questions.</h2>
          <p class="section-copy">
            Clear answers for installation, compatibility, privacy, and where product feedback should go.
          </p>

          <div class="faq-list">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="final-cta" id="download" aria-labelledby="download-title">
        <div>
          <h2 id="download-title">Turn the notch into signal.</h2>
          <p>
            Download {releaseName} for macOS, or use GitHub Issues for problems and feature requests.
          </p>
          <div class="final-actions">
            <a class="button primary" href={downloadUrl} aria-label={`Download ${releaseName} for macOS`}>Download ZackEyes <span aria-hidden="true">↓</span></a>
            <a class="button" href="/docs">Install guide</a>
            <a class="button" href="/download">Download details</a>
            <a class="button" href={issuesUrl} aria-label="Open ZackEyes issues and feature requests on GitHub">Issues & requests <span aria-hidden="true">↗</span></a>
          </div>
          <dl class="download-meta" aria-label="Download verification">
            <div>
              <dt>Current version</dt>
              <dd>{releaseName}</dd>
            </div>
            <div>
              <dt>File</dt>
              <dd>{downloadSizeLabel}</dd>
            </div>
            <div>
              <dt>SHA256</dt>
              <dd>{downloadSha256}</dd>
            </div>
          </dl>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>

  <script is:inline>
    const canvas = document.getElementById("cosmos");
    const ctx = canvas instanceof HTMLCanvasElement ? canvas.getContext("2d") : null;
    const story = document.querySelector(".scroll-story");
    const hero = document.querySelector(".hero");

    if (ctx && canvas && story) {
      const root = document.documentElement;
      const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const requestIdle = typeof window.requestIdleCallback === "function"
        ? window.requestIdleCallback.bind(window)
        : (callback) => window.setTimeout(callback, 16);
      const cancelIdle = typeof window.cancelIdleCallback === "function"
        ? window.cancelIdleCallback.bind(window)
        : window.clearTimeout.bind(window);
      const dots = [];
      let width = 0;
      let height = 0;
      let dpr = 1;
      let animationFrame = 0;
      let idleFrame = 0;
      let lastCanvasFrame = 0;
      let scrollFrame = 0;
      let canvasVisible = true;
      const canvasFrameInterval = 1000 / 24;

      function resizeCanvas() {
        width = window.innerWidth;
        height = window.innerHeight;
        dpr = Math.min(window.devicePixelRatio || 1, width < 700 ? 1 : 1.5);
        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        canvas.style.width = width + "px";
        canvas.style.height = height + "px";
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seedDots();
      }

      function seedDots() {
        dots.length = 0;
        const count = width < 700 ? 18 : 32;
        for (let i = 0; i < count; i += 1) {
          const cyan = Math.random() > 0.5;
          dots.push({
            x: Math.random() * width,
            y: Math.random() * height,
            r: 1 + Math.random() * 2.2,
            vx: -0.12 + Math.random() * 0.24,
            vy: -0.08 + Math.random() * 0.16,
            hue: cyan ? "91,231,255" : "183,255,74"
          });
        }
      }

      function drawCosmos(timestamp) {
        if (reducedMotionQuery.matches || document.hidden || !canvasVisible) {
          animationFrame = 0;
          return;
        }

        if (timestamp - lastCanvasFrame < canvasFrameInterval) {
          animationFrame = requestAnimationFrame(drawCosmos);
          return;
        }

        lastCanvasFrame = timestamp;
        ctx.clearRect(0, 0, width, height);
        ctx.fillStyle = "rgba(5, 6, 5, 0.22)";
        ctx.fillRect(0, 0, width, height);

        for (let i = 0; i < dots.length; i += 1) {
          const dot = dots[i];
          dot.x += dot.vx;
          dot.y += dot.vy;
          if (dot.x < -10) dot.x = width + 10;
          if (dot.x > width + 10) dot.x = -10;
          if (dot.y < -10) dot.y = height + 10;
          if (dot.y > height + 10) dot.y = -10;

          ctx.beginPath();
          ctx.fillStyle = "rgba(" + dot.hue + ", 0.52)";
          ctx.arc(dot.x, dot.y, dot.r, 0, Math.PI * 2);
          ctx.fill();

          let links = 0;
          for (let j = i + 1; j < dots.length; j += 1) {
            const other = dots[j];
            const dx = dot.x - other.x;
            const dy = dot.y - other.y;
            const distanceSquared = dx * dx + dy * dy;
            if (distanceSquared < 13456) {
              const alpha = 0.16 - distanceSquared / 608400;
              ctx.strokeStyle = "rgba(" + dot.hue + "," + alpha + ")";
              ctx.lineWidth = 1;
              ctx.beginPath();
              ctx.moveTo(dot.x, dot.y);
              ctx.lineTo(other.x, other.y);
              ctx.stroke();
              links += 1;
              // Cap links to bound draws.
              if (links >= 4) break;
            }
          }
        }

        animationFrame = requestAnimationFrame(drawCosmos);
      }

      function updateStory() {
        const rect = story.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const progress = Math.min(1, Math.max(0, -rect.top / total));
        root.style.setProperty("--story-progress", progress.toFixed(3));
        scrollFrame = 0;
      }

      function requestStoryUpdate() {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(updateStory);
      }

      function startCosmos() {
        if (animationFrame || reducedMotionQuery.matches || document.hidden || !canvasVisible) return;
        lastCanvasFrame = 0;
        animationFrame = requestAnimationFrame(drawCosmos);
      }

      function stopCosmos() {
        if (!animationFrame) return;
        cancelAnimationFrame(animationFrame);
        animationFrame = 0;
      }

      function scheduleCosmosStart() {
        if (idleFrame || reducedMotionQuery.matches || document.hidden || !canvasVisible) return;
        idleFrame = requestIdle(() => {
          idleFrame = 0;
          startCosmos();
        }, { timeout: 900 });
      }

      function stopScheduledCosmos() {
        if (!idleFrame) return;
        cancelIdle(idleFrame);
        idleFrame = 0;
      }

      function handleMotionPreference() {
        if (reducedMotionQuery.matches) {
          stopScheduledCosmos();
          stopCosmos();
          ctx.clearRect(0, 0, width, height);
        } else {
          scheduleCosmosStart();
        }
      }

      resizeCanvas();
      updateStory();
      if ("IntersectionObserver" in window && hero) {
        const heroObserver = new IntersectionObserver((entries) => {
          canvasVisible = entries.some((entry) => entry.isIntersecting);
          if (canvasVisible) {
            scheduleCosmosStart();
          } else {
            stopScheduledCosmos();
            stopCosmos();
          }
        }, { rootMargin: "160px 0px" });
        heroObserver.observe(hero);
      } else {
        scheduleCosmosStart();
      }
      window.addEventListener("resize", () => {
        resizeCanvas();
        requestStoryUpdate();
        handleMotionPreference();
      }, { passive: true });
      window.addEventListener("scroll", requestStoryUpdate, { passive: true });
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          stopCosmos();
        } else {
          scheduleCosmosStart();
        }
      });
      if (typeof reducedMotionQuery.addEventListener === "function") {
        reducedMotionQuery.addEventListener("change", handleMotionPreference);
      } else {
        reducedMotionQuery.addListener(handleMotionPreference);
      }
    }
  </script>
</SiteLayout>
