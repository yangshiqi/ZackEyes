---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { appVersion, issuesUrl } from '../lib/release.mjs';

const description = 'ZackEyes roadmap: deeper process and session insight, more agent support, and clearer local logs controls.';
const roadmapItems = [
  {
    title: 'Process and session insight',
    horizon: 'Next',
    copy: 'Surface what an agent is really doing — open ports and child processes, the subagent tree, and current git branch and dirty state — while holding the near-zero-CPU, no-polling line.'
  },
  {
    title: 'More agent support',
    horizon: 'Exploration',
    copy: 'Keep Claude Code and Codex CLI first-class while evaluating other local AI coding agents that expose reliable lifecycle and permission events.'
  },
  {
    title: 'Local logs controls',
    horizon: 'Exploration',
    copy: 'Expose clearer controls for local log capture and retention.'
  }
];
const roadmapStructuredData = {
  '@type': 'ItemList',
  '@id': 'https://zackeyes.app/roadmap#items',
  name: 'ZackEyes roadmap',
  itemListElement: roadmapItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: item.copy
  }))
};
---

<SiteLayout
  title="Roadmap - ZackEyes"
  description={description}
  canonical="https://zackeyes.app/roadmap"
  structuredData={[roadmapStructuredData]}
>
  <div class="grain" aria-hidden="true"></div>

  <div class="site-shell">
    <SiteHeader />

    <main id="top">
      <section class="policy-hero compact-page-hero" aria-labelledby="roadmap-title">
        <div class="policy-shell">
          <div class="section-eyebrow">Product direction</div>
          <h1 id="roadmap-title">Roadmap.</h1>
          <p class="policy-lede">
            ZackEyes is focused on reliable local agent awareness: sharper session and process insight, broader agent support, and clearer local logs controls — without breaking its near-zero-CPU, zero-dependency design.
          </p>
          <p class="policy-lede">
            The current release is v{appVersion} — see the <a href="/changelog">changelog</a> for what has shipped; below is what is next.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={issuesUrl}>Request a feature <span aria-hidden="true">↗</span></a>
            <a class="button" href="/changelog">Read changelog</a>
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="roadmap-items-title">
        <div class="policy-shell">
          <h2 class="section-title" id="roadmap-items-title">What is next.</h2>
          <div class="timeline-list">
            {roadmapItems.map((item) => (
              <article class="timeline-item">
                <span>{item.horizon}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</SiteLayout>
