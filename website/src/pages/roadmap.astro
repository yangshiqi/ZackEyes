---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { issuesUrl } from '../lib/release.mjs';

const description = 'ZackEyes roadmap: quota burn-rate prediction, completion recaps, quieter notifications, hook health and event resilience, deeper process and session insight, more agent support, and privacy controls.';
const roadmapItems = [
  {
    title: 'Quota burn-rate prediction',
    horizon: 'Next',
    copy: 'Project when the current session will hit the 5-hour or weekly limit at the present token burn rate — so you can pace work before the wall instead of discovering it mid-task.'
  },
  {
    title: 'Completion recaps and quieter alerts',
    horizon: 'Next',
    copy: 'Summarize what a finished run actually did, mute or schedule noisy notifications, and flag when usage data has gone stale — across Claude Code and Codex sessions.'
  },
  {
    title: 'Per-session permission rules',
    horizon: 'Planned',
    copy: 'Remember "always allow this tool for this session" so trusted, repetitive approvals stop interrupting flow — without weakening the prompt for anything new.'
  },
  {
    title: 'Hook health and event resilience',
    horizon: 'Planned',
    copy: 'Detect broken or missing hooks with one-click repair, keep improving Codex JSONL fallback and session cleanup, and replay events through a watchdog so a busy moment never drops a session update.'
  },
  {
    title: 'Process and session insight',
    horizon: 'Exploration',
    copy: 'Surface what an agent is really doing — open ports and child processes, the subagent tree, and current git branch and dirty state — while holding the near-zero-CPU, no-polling line.'
  },
  {
    title: 'More agent support',
    horizon: 'Exploration',
    copy: 'Keep Claude Code and Codex CLI first-class while evaluating other local AI coding agents that expose reliable lifecycle and permission events.'
  },
  {
    title: 'Privacy and logs controls',
    horizon: 'Exploration',
    copy: 'Expose clearer controls for local logs, local settings cleanup, and diagnostics that are safe to share in GitHub Issues.'
  }
];
const roadmapStructuredData = {
  '@type': 'ItemList',
  '@id': 'https://zackeyes.app/roadmap#items',
  name: 'ZackEyes roadmap',
  itemListElement: roadmapItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: item.copy
  }))
};
---

<SiteLayout
  title="Roadmap - ZackEyes"
  description={description}
  canonical="https://zackeyes.app/roadmap"
  structuredData={[roadmapStructuredData]}
>
  <div class="grain" aria-hidden="true"></div>

  <div class="site-shell">
    <SiteHeader />

    <main id="top">
      <section class="policy-hero compact-page-hero" aria-labelledby="roadmap-title">
        <div class="policy-shell">
          <div class="section-eyebrow">Product direction</div>
          <h1 id="roadmap-title">Roadmap.</h1>
          <p class="policy-lede">
            ZackEyes is focused on reliable local agent awareness: predicting quota burn-rate before you hit the wall, sharper session and process insight, quieter notifications, and stronger hook resilience — without breaking its near-zero-CPU, zero-dependency design.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={issuesUrl}>Request a feature <span aria-hidden="true">↗</span></a>
            <a class="button" href="/changelog">Read changelog</a>
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="roadmap-items-title">
        <div class="policy-shell">
          <h2 class="section-title" id="roadmap-items-title">What is next.</h2>
          <div class="timeline-list">
            {roadmapItems.map((item) => (
              <article class="timeline-item">
                <span>{item.horizon}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</SiteLayout>
