---
import { featureVersion, journalVersion } from '../lib/product-plans.mjs';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { appVersion, issuesUrl } from '../lib/release.mjs';

const description = `ZackEyes roadmap: released SSH observation, daily usage archives and notch answers, plus future journal and agent plans.`;
const releasedItems = [
  { title: 'Answer from the notch', horizon: `Released · v${featureVersion}`, copy: 'Opt-in answers for supported Claude questions, with a timeout and terminal fallback. Disabled by default.' },
  { title: 'SSH remote observation', horizon: `Released · v${featureVersion}`, copy: 'Read-only Claude/Codex session metadata from up to eight SSH hosts, with host status and reconnect. Remote requests stay in the remote terminal.' },
  { title: 'Demo fleet', horizon: `Released · v${featureVersion}`, copy: 'Explore synthetic Claude/Codex sessions without sending sample actions to real agents. Real session attention returns the panel to live sessions.' },
  { title: 'Local usage history', horizon: `Released · v${featureVersion}`, copy: 'Incremental daily archives through yesterday, settled after 03:00 with startup catch-up. Includes 7/30/90-day token and estimated agent-hour views, dated chart hover details, cache hit rate, rankings and an activity heatmap. Older history is imported explicitly with pause/resume. No prompts or tool arguments are stored.' },
  { title: 'Stale quota readings', horizon: `Released · v${featureVersion}`, copy: 'Per-agent approximate markers and last-updated hints distinguish old quota readings from fresh observations.' }
];
const roadmapItems = [
  {
    title: 'Daily work journal',
    horizon: `v${journalVersion} · planned`,
    copy: `Finish setup, scheduling and delivery around the existing local pipeline. Not included in the v${featureVersion} release; the unfinished generation menu is hidden. Distil each day of agent work into a dated summary plus a running lessons file, committed to a private GitHub repo you choose. Summarising runs on the agent CLI already installed on your Mac, so there is no API key and no new dependency.`
  },
  {
    title: 'More agent support',
    horizon: 'Exploration',
    copy: 'Keep Claude Code and Codex CLI first-class while evaluating other local AI coding agents that expose reliable lifecycle and permission events.'
  },
  {
    title: 'Local logs controls',
    horizon: 'Exploration',
    copy: 'Expose clearer controls for local log capture and retention.'
  }
];
const roadmapStructuredData = {
  '@type': 'ItemList',
  '@id': 'https://zackeyes.vercel.app/roadmap#items',
  name: 'ZackEyes roadmap',
  itemListElement: roadmapItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.title,
    description: item.copy
  }))
};
---

<SiteLayout
  title="Roadmap - ZackEyes"
  description={description}
  canonical="https://zackeyes.vercel.app/roadmap"
  structuredData={[roadmapStructuredData]}
>
  <div class="grain" aria-hidden="true"></div>

  <div class="site-shell">
    <SiteHeader />

    <main id="top">
      <section class="policy-hero compact-page-hero" aria-labelledby="roadmap-title">
        <div class="policy-shell">
          <div class="section-eyebrow">Product direction</div>
          <h1 id="roadmap-title">Roadmap.</h1>
          <p class="policy-lede">
            Released features include SSH observation, local usage history, opt-in notch answers, demo sessions and stale quota hints. Future work includes journal delivery, broader agent support and local logs controls.
          </p>
          <p class="policy-lede">
            The current release is v{appVersion} — see the <a href="/changelog">changelog</a> for what has shipped. The features below shipped in v{featureVersion}.
          </p>
          <div class="hero-actions">
            <a class="button primary" href={issuesUrl}>Request a feature <span aria-hidden="true">↗</span></a>
            <a class="button" href="/changelog">Read changelog</a>
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="released-items-title">
        <div class="policy-shell">
          <h2 class="section-title" id="released-items-title">Released in v{featureVersion}.</h2>
          <p class="section-copy">These features are included in the published download. Future work is listed separately below; no date is promised for planned items.</p>
          <div class="timeline-list">
            {releasedItems.map((item) => (
              <article class="timeline-item">
                <span>{item.horizon}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="policy-band" aria-labelledby="roadmap-items-title">
        <div class="policy-shell">
          <h2 class="section-title" id="roadmap-items-title">What is next.</h2>
          <p class="section-copy">Codex GPT-6 and Claude model compatibility are included in v0.9.7. See the <a href="/docs#model-compatibility">compatibility notes</a>; future work is listed below.</p>
          <div class="timeline-list">
            {roadmapItems.map((item) => (
              <article class="timeline-item">
                <span>{item.horizon}</span>
                <h3>{item.title}</h3>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </div>
</SiteLayout>
