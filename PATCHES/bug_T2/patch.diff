diff --git a/Sources/AppLib/Usage/UsageTracker.swift b/Sources/AppLib/Usage/UsageTracker.swift
--- a/Sources/AppLib/Usage/UsageTracker.swift
+++ b/Sources/AppLib/Usage/UsageTracker.swift
@@ -497,9 +497,15 @@
             for file in files where file.pathExtension == "jsonl" {
